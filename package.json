{
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.local -- bun --bun vite dev --host",
    "build": "bun --bun vite build",
    "start": "bun --bun vite preview --host",
    "check": "tsr generate && oxfmt && oxlint --type-aware --fix && tsc --noEmit --pretty",
    "auth:generate": "dotenvx run -f .env.local -- better-auth generate --config src/lib/auth/auth.ts --output src/lib/database/auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-local": "dotenvx run -f .env.local -- drizzle-kit migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@orpc/client": "^1.13.13",
    "@orpc/server": "^1.13.13",
    "@orpc/tanstack-query": "^1.13.13",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.167.16",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-cli": "^1.166.25",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
